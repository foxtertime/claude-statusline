root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# shfmt читает эти же настройки
[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true

[.githooks/*]
indent_style = space
indent_size = 4
switch_case_indent = true

[Makefile]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
